# STRATEGY Control Center — Environment Variables

PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://strategyaccademy.netlify.app

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/strategy_db

# Security & Auth Tokens
JWT_SECRET=strategy_super_secret_jwt_key_32_chars_min_2026
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=strategy_refresh_token_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=strategy_cookie_session_secret_key_2026

# Storage / Upload Directory
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=10

# Super Admin Initial Password (for seeding)
SEED_SUPER_ADMIN_EMAIL=admin@strategy.ae
SEED_SUPER_ADMIN_PASSWORD=Password123!
